#!/usr/bin/env bash
#
# game-run — launch a Steam game on the discrete AMD Radeon R5 M445 with the
# maximum this laptop can sustain, on the big external monitor.
#
# Steam launch options:   /home/ahmad/.local/bin/game-run %command%
#
# What it does:
#   * puts the game on the external monitor (GNOME primary + SDL display hints)
#   * wakes the dGPU (it is runtime-suspended; amdgpu saves battery when idle)
#   * forces DRI_PRIME + the RADV Vulkan ICD, so DXVK/VKD3D/native Vulkan all
#     land on the dGPU instead of the Intel HD 620
#   * enables Mesa's pipeline library and a larger on-disk shader cache, which
#     removes most of the first-run compile stutter
#   * hands the process to GameMode (CPU governor, I/O priority, reaper)
#
# Environment overrides:
#   GAME_MONITOR=DP-1      use a different output (default: first external one)
#   GAME_SINGLE_OUTPUT=1   turn the laptop panel off while the game runs, so the
#                          game cannot open on it (restored when the game exits)
#   GAME_HUD=1             draw MangoHud over the game
#
set -uo pipefail

DGPU_PCI="pci-0000_01_00_0"

# Layout args for `gdctl set`, rebuilt from the live xrandr state so nothing
# moves when the configuration is re-applied. Pass a connector to mark primary.
current_layout() {
  local want="${1:-}" name geometry rest
  while read -r name geometry; do
    rest="${geometry#*+}"
    printf '%s\0%s\0%s\0%s\0%s\0' \
      --logical-monitor --monitor "$name" --x "${rest%%+*}" --y "${rest##*+}"
    [[ "$name" == "$want" ]] && printf '%s\0' --primary
  done < <(xrandr --query 2>/dev/null | awk '
    / connected / { for (i = 1; i <= NF; i++) if ($i ~ /^[0-9]+x[0-9]+\+/) { print $1, $i; break } }')
}

# --- Display ----------------------------------------------------------------
# GNOME opens new windows on the primary monitor, and XWayland/Wine use it for
# fullscreen, so the primary is what decides where a game appears by default.
game_monitor="${GAME_MONITOR:-}"
if [[ -z "$game_monitor" ]]; then
  # xrandr names are the ones gdctl/Steam see (HDMI-1, not the DRM HDMI-A-1);
  # the internal panel is eDP/LVDS/DSI, everything else counts as external.
  game_monitor="$(xrandr --query 2>/dev/null |
    awk '/ connected /{print $1}' |
    grep -vE '^(eDP|LVDS|DSI)' |
    head -n 1)"
fi

if [[ -n "$game_monitor" ]] && command -v gdctl >/dev/null 2>&1; then
  primary="$(xrandr --query 2>/dev/null | awk '/ connected primary /{print $1; exit}')"
  if [[ -n "$primary" && "$primary" != "$game_monitor" ]]; then
    layout=()
    mapfile -d '' layout < <(current_layout "$game_monitor")
    if ((${#layout[@]})); then
      gdctl set -P "${layout[@]}" >/dev/null 2>&1 \
        && printf 'game-run: %s is now the primary display\n' "$game_monitor" >&2 \
        || printf 'game-run: warning: could not make %s primary\n' "$game_monitor" >&2
    fi
  fi
fi

# SDL3 (CS2, most native Linux games) numbers displays from XRandR and lets the
# game pick one by index; SDL2 and sdl2-compat read the same index hint.
sdl_index="$(xrandr --listmonitors 2>/dev/null |
  awk -v want="$game_monitor" '$NF == want { sub(":", "", $1); print $1; exit }')"
if [[ -n "$sdl_index" ]]; then
  export SDL_VIDEO_FULLSCREEN_DISPLAY="$sdl_index"
  export SDL_VIDEO_DISPLAY_PRIORITY="$sdl_index"
fi

# Optional: leave the laptop panel off for the whole session. Guarantees the
# game cannot pick it, at the cost of the second screen while playing.
restore_display() {
  ((${#saved_layout[@]})) || return 0
  gdctl set -P "${saved_layout[@]}" >/dev/null 2>&1 || true
}

saved_layout=()
single_output=false
if [[ "${GAME_SINGLE_OUTPUT:-0}" == 1 && -n "$game_monitor" ]] &&
   command -v gdctl >/dev/null 2>&1; then
  mapfile -d '' saved_layout < <(current_layout "$primary")
  gdctl set -P --logical-monitor --monitor "$game_monitor" --primary --x 0 --y 0 \
    >/dev/null 2>&1 && single_output=true
  trap restore_display EXIT INT TERM
fi

# The dGPU may be power-gated and its render node absent until amdgpu probes.
if [ ! -e "/dev/dri/by-path/${DGPU_PCI}-render" ]; then
  modprobe amdgpu 2>/dev/null || true
  for _ in $(seq 1 100); do
    [ -e "/dev/dri/by-path/${DGPU_PCI}-render" ] && break
    sleep 0.05
  done
fi

# Render (behind the scenes) on the dGPU, display on the Intel iGPU (PRIME).
export DRI_PRIME="${DGPU_PCI}"

# Vulkan: only expose RADV. Without this the loader enumerates Intel first and
# DXVK/VKD3D may pick the much slower HD 620.
export VK_LOADER_DRIVERS_SELECT='*radeon*'

# Mesa / RADV: Graphics Pipeline Library is on by default in modern Mesa, keep
# it explicit; a bigger cache avoids recompiling shaders every session.
export RADV_PERFTEST=gpl
export MESA_SHADER_CACHE_MAX_SIZE=6G
export mesa_glthread=true

# Proton shader caches on the SSD (both are enabled by default, pin the paths so
# they survive prefix cleanups).
cache="${XDG_CACHE_HOME:-$HOME/.cache}"
export DXVK_STATE_CACHE=1
export VKD3D_SHADER_CACHE_PATH="$cache/vkd3d"
mkdir -p "$cache/vkd3d" 2>/dev/null || true

if [[ "${GAME_HUD:-0}" == 1 ]] && command -v mangohud >/dev/null 2>&1; then
  set -- mangohud "$@"
fi

if [[ "$single_output" == true ]]; then
  # No exec: the EXIT trap has to bring the laptop panel back.
  gamemoderun "$@"
  exit $?
fi
exec gamemoderun "$@"
